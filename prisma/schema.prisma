generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  module      String   @default("general")
  color       String   @default("#0D6B3F")
  images      String   @default("[]")  // JSON array of {url, alt, caption}
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news        News[]
  publications Publication[]
  laporan     Laporan[]
  gallery     Gallery[]
}

model BlobFile {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  compressedSize Int   @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  path        String
  thumbnailPath String @default("")
  category    String   @default("general")
  altText     String   @default("")
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  image     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id         String   @id @default(cuid())
  title      String
  excerpt    String
  content    String   @default("")
  date       String
  category   String
  categoryId String?
  image      String
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  readTime   String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  date        String
  time        String
  location    String
  status      String   @default("upcoming")
  images      String   @default("[]")  // JSON array of {url, alt, caption}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id         String   @id @default(cuid())
  image      String
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  caption    String
  order      Int      @default(0)
  active     Boolean  @default(true)
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Stat {
  id        String   @id @default(cuid())
  icon      String
  value     String
  prefix    String   @default("")
  suffix    String   @default("")
  label     String
  color     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  content     String   @default("")
  color       String
  bgColor     String
  images      String   @default("[]")  // JSON array of {url, alt, caption}
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialData {
  id         String   @id @default(cuid())
  year       String
  pendapatan Int
  belanja    Int
  realisasi  Float
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PageContent {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  description       String   @default("")
  content           String
  heroImage         String   @default("")
  image             String   @default("")
  images            String   @default("[]")  // JSON array of {url, alt, caption}
  downloadableFiles String   @default("[]")  // JSON array of {url, name, originalName, mimeType, size}
  metaTitle         String   @default("")
  metaDescription   String   @default("")
  metaKeywords      String   @default("")
  published         Boolean  @default(true)
  order             Int      @default(0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model NavbarMenu {
  id            String   @id @default(cuid())
  label         String
  slug          String   @unique
  parentId      String?
  icon          String   @default("FileText")
  order         Int      @default(0)
  active        Boolean  @default(true)
  isDynamic     Boolean  @default(true)
  externalUrl   String   @default("")
  openInNewTab  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent        NavbarMenu?  @relation("NavbarMenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      NavbarMenu[] @relation("NavbarMenuHierarchy")
}

model Official {
  id        String   @id @default(cuid())
  name      String
  position  String
  photo     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  nip       String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publication {
  id                String   @id @default(cuid())
  title             String
  description       String
  category          String
  categoryId        String?
  fileUrl           String   @default("")
  coverImage        String   @default("")
  images            String   @default("[]")  // JSON array of {url, alt, caption}
  downloadableFiles String   @default("[]")  // JSON array of {url, name, originalName, mimeType, size}
  date              String
  order             Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  thumbnail String   @default("")
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  date      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Infographic {
  id        String   @id @default(cuid())
  title     String
  image     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  date      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Laporan {
  id         String   @id @default(cuid())
  name       String
  email      String   @default("")
  phone      String   @default("")
  subject    String
  message    String
  category   String   @default("umum")
  categoryId String?
  status     String   @default("baru")
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  avatar    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SetupState {
  id              String   @id @default(cuid())
  completed       Boolean  @default(false)
  currentStep     Int      @default(0)
  // Step 1: Admin Account
  adminName       String   @default("")
  adminEmail      String   @default("")
  adminPassword   String   @default("")
  // Step 2: Site Identity
  appName         String   @default("Badan Keuangan dan Aset Daerah")
  appShortName    String   @default("BKAD")
  appSubtitle     String   @default("Kabupaten Seruyan")
  primaryColor    String   @default("#0D6B3F")
  secondaryColor  String   @default("#C5960C")
  darkColor       String   @default("#064E2B")
  phone           String   @default("")
  email           String   @default("")
  address         String   @default("")
  // Step 3: Initial Menus (JSON string)
  selectedMenus   String   @default("[]")
  // Step 4: Extras
  logoUrl         String   @default("")
  workHours       String   @default("Senin - Jumat, 08:00 - 16:00 WIB")
  metaDescription String   @default("")
  metaKeywords    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppIdentity {
  id                String   @id @default(cuid())
  // Header
  appName           String   @default("Badan Keuangan dan Aset Daerah")
  appShortName      String   @default("BKAD")
  appSubtitle       String   @default("Kabupaten Seruyan")
  logoUrl           String   @default("")
  logoText          String   @default("BK")
  primaryColor      String   @default("#0D6B3F")
  secondaryColor    String   @default("#C5960C")
  darkColor         String   @default("#064E2B")
  // Top Info Bar
  phone             String   @default("(0532) 882123")
  email             String   @default("bkad@seruyankab.go.id")
  workHours         String   @default("Senin - Jumat, 08:00 - 16:00 WIB")
  topLinks          String   @default("PPID|SIPD|Lapor!")
  // Footer
  address           String   @default("Jl. Trans Kalimantan, Kuala Pembuang, Kab. Seruyan, Kalimantan Tengah 74211")
  footerDescription String   @default("Badan Keuangan dan Aset Daerah Kabupaten Seruyan, Kalimantan Tengah. Mewujudkan pengelolaan keuangan daerah yang transparan, akuntabel, dan berorientasi pada pelayanan publik.")
  facebookUrl       String   @default("")
  instagramUrl      String   @default("")
  youtubeUrl        String   @default("")
  twitterUrl        String   @default("")
  quickLinks        String   @default("Kementerian Dalam Negeri|https://kemendagri.go.id,Pemerintah Kabupaten Seruyan|#")
  layananLinks      String   @default("Pengelolaan APBD|#")
  copyrightText     String   @default("Badan Keuangan dan Aset Daerah Kabupaten Seruyan")
  // Metadata
  faviconUrl        String   @default("")
  metaDescription   String   @default("Website resmi Badan Keuangan dan Aset Daerah Kabupaten Seruyan")
  metaKeywords      String   @default("BKAD, Seruyan, Keuangan Daerah, Aset Daerah")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IkmUnit {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String   @default("")
  headName    String   @default("")
  address     String   @default("")
  phone       String   @default("")
  email       String   @default("")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses   IkmResponse[]
}

model IkmSurveyPeriod {
  id          String   @id @default(cuid())
  title       String
  period      String   @default("")
  startDate   String   @default("")
  endDate     String   @default("")
  active      Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses   IkmResponse[]
}

model IkmResponse {
  id              String   @id @default(cuid())
  unitId          String
  surveyPeriodId  String

  // 9 Standard IKM Indicators (Permenpan-RB 14/2017) - Rating 1-4
  ind1            Int      @default(0)  // Persyaratan pelayanan
  ind2            Int      @default(0)  // Prosedur pelayanan
  ind3            Int      @default(0)  // Waktu pelayanan
  ind4            Int      @default(0)  // Biaya/tarif pelayanan
  ind5            Int      @default(0)  // Produk pelayanan
  ind6            Int      @default(0)  // Kompetensi petugas
  ind7            Int      @default(0)  // Perilaku petugas
  ind8            Int      @default(0)  // Penanganan pengaduan
  ind9            Int      @default(0)  // Sarana dan prasarana

  // Respondent demographics (optional for anonymity)
  respondentName  String   @default("")
  respondentAge   String   @default("")
  respondentGender String  @default("")
  respondentEdu   String   @default("")
  respondentJob   String   @default("")

  suggestions     String   @default("")

  // Metadata
  ipAddress       String   @default("")
  userAgent       String   @default("")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unit            IkmUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  surveyPeriod    IkmSurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Cascade)
}

model AdBubble {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  
  // Content
  contentType     String   @default("image")   // image, gif, video, text, html
  mediaUrl        String   @default("")         // URL for image/gif/video
  textContent     String   @default("")         // Text promo content (supports HTML)
  ctaLabel        String   @default("")         // CTA button label
  ctaUrl          String   @default("")         // CTA button link
  ctaTarget       String   @default("_blank")   // _blank or _self
  
  // Display style
  displayType     String   @default("floating-bubble")  // floating-bubble, sticky-banner, popup-mini, floating-card
  displayMode     String   @default("rounded-bubble")   // rounded-bubble, glassmorphism, neumorphism, minimal-clean
  
  // Position
  position        String   @default("bottom-right")  // top-left, top-right, bottom-left, bottom-right, center-left, center-right, center
  customOffsetX   Int      @default(0)               // Additional X offset in px
  customOffsetY   Int      @default(0)               // Additional Y offset in px
  
  // Size
  width           Int      @default(300)             // Width in px
  height          Int      @default(250)             // Height in px
  mobileWidth     Int      @default(200)
  mobileHeight    Int      @default(180)
  
  // Appearance
  bgColor         String   @default("#ffffff")
  bgOpacity       Float    @default(1.0)             // 0.0 - 1.0
  borderRadius    Int      @default(16)              // Border radius in px
  shadowSize      String   @default("md")            // none, sm, md, lg, xl
  borderColor     String   @default("#e5e7eb")
  borderWidth     Int      @default(0)
  
  // Animation
  animIn          String   @default("fade")          // fade, slide, bounce, zoom, none
  animOut         String   @default("fade")          // fade, slide, zoom, none
  animDuration    Int      @default(500)             // Animation duration in ms
  
  // Behavior
  showDelay       Int      @default(0)               // Delay before showing (ms)
  autoHide        Int      @default(0)               // Auto hide after X ms (0 = never)
  showOnScroll    Int      @default(0)               // Show after X px scroll (0 = always)
  exitIntent      Boolean  @default(false)           // Show on exit intent
  closeable       Boolean  @default(true)            // Show close button
  minimizable     Boolean  @default(false)           // Show minimize button
  draggable       Boolean  @default(true)            // Allow drag & drop
  
  // Scheduling
  startDate       String   @default("")              // ISO date string
  endDate         String   @default("")              // ISO date string
  showHours       String   @default("")              // JSON: {start: "08:00", end: "22:00"}
  
  // Targeting
  targetDevice    String   @default("all")           // all, mobile, desktop
  targetPages     String   @default("[]")            // JSON array of page slugs, empty = all
  targetExclude   String   @default("[]")            // JSON array of excluded page slugs
  
  // Priority & Order
  zIndex          Int      @default(9999)
  order           Int      @default(0)
  priority        Int      @default(0)               // Higher = more important
  
  // Status
  active          Boolean  @default(true)
  
  // Statistics
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
