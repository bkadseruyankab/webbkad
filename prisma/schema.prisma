generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  module      String   @default("general")
  color       String   @default("#0D6B3F")
  images      String   @default("[]")  // JSON array of {url, alt, caption}
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news        News[]
  publications Publication[]
  laporan     Laporan[]
  gallery     Gallery[]
}

model BlobFile {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  compressedSize Int   @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  path        String
  thumbnailPath String @default("")
  category    String   @default("general")
  altText     String   @default("")
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  image     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id         String   @id @default(cuid())
  title      String
  excerpt    String
  content    String   @default("")
  date       String
  category   String
  categoryId String?
  image      String
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  readTime   String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  date        String
  time        String
  location    String
  status      String   @default("upcoming")
  images      String   @default("[]")  // JSON array of {url, alt, caption}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id         String   @id @default(cuid())
  image      String
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  caption    String
  order      Int      @default(0)
  active     Boolean  @default(true)
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Stat {
  id        String   @id @default(cuid())
  icon      String
  value     String
  prefix    String   @default("")
  suffix    String   @default("")
  label     String
  color     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  content     String   @default("")
  color       String
  bgColor     String
  images      String   @default("[]")  // JSON array of {url, alt, caption}
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialData {
  id         String   @id @default(cuid())
  year       String
  pendapatan Int
  belanja    Int
  realisasi  Float
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PageContent {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  description       String   @default("")
  content           String
  heroImage         String   @default("")
  image             String   @default("")
  images            String   @default("[]")  // JSON array of {url, alt, caption}
  downloadableFiles String   @default("[]")  // JSON array of {url, name, originalName, mimeType, size}
  metaTitle         String   @default("")
  metaDescription   String   @default("")
  metaKeywords      String   @default("")
  published         Boolean  @default(true)
  order             Int      @default(0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model NavbarMenu {
  id            String   @id @default(cuid())
  label         String
  slug          String   @unique
  parentId      String?
  icon          String   @default("FileText")
  order         Int      @default(0)
  active        Boolean  @default(true)
  isDynamic     Boolean  @default(true)
  externalUrl   String   @default("")
  openInNewTab  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent        NavbarMenu?  @relation("NavbarMenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      NavbarMenu[] @relation("NavbarMenuHierarchy")
}

model Official {
  id        String   @id @default(cuid())
  name      String
  position  String
  photo     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  nip       String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publication {
  id                String   @id @default(cuid())
  title             String
  description       String
  category          String
  categoryId        String?
  fileUrl           String   @default("")
  coverImage        String   @default("")
  images            String   @default("[]")  // JSON array of {url, alt, caption}
  downloadableFiles String   @default("[]")  // JSON array of {url, name, originalName, mimeType, size}
  date              String
  order             Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  thumbnail String   @default("")
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  date      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Infographic {
  id        String   @id @default(cuid())
  title     String
  image     String
  images    String   @default("[]")  // JSON array of {url, alt, caption}
  date      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Laporan {
  id         String   @id @default(cuid())
  name       String
  email      String   @default("")
  phone      String   @default("")
  subject    String
  message    String
  category   String   @default("umum")
  categoryId String?
  status     String   @default("baru")
  images     String   @default("[]")  // JSON array of {url, alt, caption}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  avatar    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SetupState {
  id              String   @id @default(cuid())
  completed       Boolean  @default(false)
  currentStep     Int      @default(0)
  // Step 1: Admin Account
  adminName       String   @default("")
  adminEmail      String   @default("")
  adminPassword   String   @default("")
  // Step 2: Site Identity
  appName         String   @default("Badan Keuangan dan Aset Daerah")
  appShortName    String   @default("BKAD")
  appSubtitle     String   @default("Kabupaten Seruyan")
  primaryColor    String   @default("#0D6B3F")
  secondaryColor  String   @default("#C5960C")
  darkColor       String   @default("#064E2B")
  phone           String   @default("")
  email           String   @default("")
  address         String   @default("")
  // Step 3: Initial Menus (JSON string)
  selectedMenus   String   @default("[]")
  // Step 4: Extras
  logoUrl         String   @default("")
  workHours       String   @default("Senin - Jumat, 08:00 - 16:00 WIB")
  metaDescription String   @default("")
  metaKeywords    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppIdentity {
  id                String   @id @default(cuid())
  // Header
  appName           String   @default("Badan Keuangan dan Aset Daerah")
  appShortName      String   @default("BKAD")
  appSubtitle       String   @default("Kabupaten Seruyan")
  logoUrl           String   @default("")
  logoText          String   @default("BK")
  primaryColor      String   @default("#0D6B3F")
  secondaryColor    String   @default("#C5960C")
  darkColor         String   @default("#064E2B")
  // Top Info Bar
  phone             String   @default("(0532) 882123")
  email             String   @default("bkad@seruyankab.go.id")
  workHours         String   @default("Senin - Jumat, 08:00 - 16:00 WIB")
  topLinks          String   @default("PPID|SIPD|Lapor!")
  // Footer
  address           String   @default("Jl. Trans Kalimantan, Kuala Pembuang, Kab. Seruyan, Kalimantan Tengah 74211")
  footerDescription String   @default("Badan Keuangan dan Aset Daerah Kabupaten Seruyan, Kalimantan Tengah. Mewujudkan pengelolaan keuangan daerah yang transparan, akuntabel, dan berorientasi pada pelayanan publik.")
  facebookUrl       String   @default("")
  instagramUrl      String   @default("")
  youtubeUrl        String   @default("")
  twitterUrl        String   @default("")
  quickLinks        String   @default("Kementerian Dalam Negeri|https://kemendagri.go.id,Pemerintah Kabupaten Seruyan|#")
  layananLinks      String   @default("Pengelolaan APBD|#")
  copyrightText     String   @default("Badan Keuangan dan Aset Daerah Kabupaten Seruyan")
  // Metadata
  faviconUrl        String   @default("")
  metaDescription   String   @default("Website resmi Badan Keuangan dan Aset Daerah Kabupaten Seruyan")
  metaKeywords      String   @default("BKAD, Seruyan, Keuangan Daerah, Aset Daerah")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
