generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  module      String   @default("general")
  color       String   @default("#0D6B3F")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news        News[]
  publications Publication[]
  laporan     Laporan[]
  gallery     Gallery[]
}

model BlobFile {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  compressedSize Int   @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  path        String
  thumbnailPath String @default("")
  category    String   @default("general")
  altText     String   @default("")
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  image     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id         String   @id @default(cuid())
  title      String
  excerpt    String
  content    String   @default("")
  date       String
  category   String
  categoryId String?
  image      String
  readTime   String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  date        String
  time        String
  location    String
  status      String   @default("upcoming")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id         String   @id @default(cuid())
  image      String
  caption    String
  order      Int      @default(0)
  active     Boolean  @default(true)
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Stat {
  id        String   @id @default(cuid())
  icon      String
  value     String
  prefix    String   @default("")
  suffix    String   @default("")
  label     String
  color     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  content     String   @default("")
  color       String
  bgColor     String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialData {
  id         String   @id @default(cuid())
  year       String
  pendapatan Int
  belanja    Int
  realisasi  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  image     String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Official {
  id        String   @id @default(cuid())
  name      String
  position  String
  photo     String
  nip       String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publication {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  categoryId  String?
  fileUrl     String   @default("")
  coverImage  String   @default("")
  date        String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  thumbnail String   @default("")
  date      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Infographic {
  id        String   @id @default(cuid())
  title     String
  image     String
  date      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Laporan {
  id         String   @id @default(cuid())
  name       String
  email      String   @default("")
  phone      String   @default("")
  subject    String
  message    String
  category   String   @default("umum")
  categoryId String?
  status     String   @default("baru")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])
}
